' PIZERO-250: Symphony-12 stereo test. Chip 1 (left) and chip 4 (right) take
' turns on one note, four times each; then chips 2 (left) and 3 (right) hold
' a fifth. With symphony12_stereo = off it all comes from the middle.
10 CLS:PRINT"SYMPHONY-12: STEREO"
20 DIM M(3):M(0)=1:M(1)=4:M(2)=16:M(3)=64
30 POKE &HFF61,0:POKE &HFF60,255:POKE &HFF61,4:POKE &HFF63,0:POKE &HFF62,255:POKE &HFF63,4
40 FOR K=0 TO 3:R=7:V=62:GOSUB 100:R=0:V=213:GOSUB 100:NEXT K
50 FOR N=1 TO 4
60 PRINT"LEFT ";:K=0:R=8:V=12:GOSUB 100:FOR T=1 TO 400:NEXT T:V=0:GOSUB 100
70 PRINT"RIGHT":K=3:R=8:V=12:GOSUB 100:FOR T=1 TO 400:NEXT T:V=0:GOSUB 100
80 NEXT N
90 PRINT"BOTH":K=1:R=0:V=143:GOSUB 100:R=8:V=12:GOSUB 100:K=2:R=0:V=213:GOSUB 100:R=8:V=12:GOSUB 100:FOR T=1 TO 2000:NEXT T:V=0:GOSUB 100:K=1:GOSUB 100:PRINT"DONE":END
100 POKE &HFF60,R:POKE &HFF62,3*M(K):POKE &HFF62,0:POKE &HFF60,V:POKE &HFF62,2*M(K):POKE &HFF62,0:RETURN
