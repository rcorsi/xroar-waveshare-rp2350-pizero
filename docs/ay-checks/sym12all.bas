' PIZERO-149: all twelve Symphony-12 voices (four chips, three channels each).
' Voices come in one at a time, chip 0 A B C then chip 1 A B C and so on, a
' C major chord from C3 up to G6, then all stop. Saved on AYTEST.DSK as SYM12ALL.
10 CLS:PRINT"SYMPHONY-12: TWELVE VOICES"
20 DIM M(3):M(0)=1:M(1)=4:M(2)=16:M(3)=64
30 POKE &HFF61,0:POKE &HFF60,255:POKE &HFF61,4:POKE &HFF63,0:POKE &HFF62,255:POKE &HFF63,4
40 FOR K=0 TO 3:R=7:V=56:GOSUB 200:FOR R=8 TO 10:V=0:GOSUB 200:NEXT R:NEXT K
50 FOR N=0 TO 11:READ T:K=INT(N/3):C=N-3*K
60 PRINT"VOICE";N+1;"CHIP";K;"CHANNEL ";CHR$(65+C)
70 R=2*C:V=T-256*INT(T/256):GOSUB 200:R=2*C+1:V=INT(T/256):GOSUB 200:R=8+C:V=10:GOSUB 200
80 FOR D=1 TO 400:NEXT D:NEXT N
90 FOR D=1 TO 1500:NEXT D
100 FOR K=0 TO 3:FOR R=8 TO 10:V=0:GOSUB 200:NEXT R:NEXT K:PRINT"DONE":END
200 POKE &HFF60,R:POKE &HFF62,3*M(K):POKE &HFF62,0:POKE &HFF60,V:POKE &HFF62,2*M(K):POKE &HFF62,0:RETURN
210 DATA 428,339,285,214,170,143,107,85,71,53,42,36
