' PIZERO-149: Symphony-12 test (four AY-3-8910s through a PIA at $FF60-$FF63).
' Each chip adds one note of a C major chord (C4 E4 G4 C5), then all stop.
10 CLS:PRINT"SYMPHONY-12: FOUR CHIPS"
20 DIM M(3):M(0)=1:M(1)=4:M(2)=16:M(3)=64
30 POKE &HFF61,0:POKE &HFF60,255:POKE &HFF61,4:POKE &HFF63,0:POKE &HFF62,255:POKE &HFF63,4
40 FOR K=0 TO 3:PRINT"CHIP";K
50 FOR R=0 TO 10:READ V:GOSUB 100:NEXT R
60 FOR T=1 TO 800:NEXT T:NEXT K
70 FOR T=1 TO 1500:NEXT T
80 FOR K=0 TO 3:R=8:V=0:GOSUB 100:NEXT K:PRINT"DONE":END
100 POKE &HFF60,R:POKE &HFF62,3*M(K):POKE &HFF62,0:POKE &HFF60,V:POKE &HFF62,2*M(K):POKE &HFF62,0:RETURN
110 DATA 213,0,0,0,0,0,0,62,12,0,0
120 DATA 169,0,0,0,0,0,0,62,12,0,0
130 DATA 143,0,0,0,0,0,0,62,12,0,0
140 DATA 107,0,0,0,0,0,0,62,12,0,0
