' PIZERO-250: every voice at once. The Symphony-12's twelve AY tones (chips
' 1-2 left, 3-4 right in stereo), the Games Master's three SN76489 tones and
' its noise as a drum, AY envelopes for a stereo swell, then the CoCo's own
' DAC (SOUND) on top: sixteen voices and the DAC. Needs machine = cocozero.
10 CLS:PRINT"SYMPHONY-12 + GAMES MASTER":PRINT"TUNING..."
20 DIM M(3),T(64),N(64),B(3),C(2):M(0)=1:M(1)=4:M(2)=16:M(3)=64:B(0)=0:B(1)=24:B(2)=12:B(3)=36
30 F=65.406:FOR S=0 TO 64:T(S)=INT(55930/F+.5):N(S)=INT(125000/F+.5):F=F*1.059463:NEXT S
40 POKE &HFF61,0:POKE &HFF60,255:POKE &HFF61,4:POKE &HFF63,0:POKE &HFF62,255:POKE &HFF63,4
50 FOR K=0 TO 3:R=7:V=56:GOSUB 1000:NEXT K:FOR J=0 TO 2:POKE &HFF41,159+J*32:NEXT J:POKE &HFF41,255
60 PRINT"ADDING VOICES":C(0)=0:C(1)=4:C(2)=7
70 FOR K=0 TO 3:FOR J=0 TO 2:S=B(K)+C(J):GOSUB 1100:R=8+J:V=12:GOSUB 1000:Q=Q+1:PRINT Q;:NEXT J,K
80 FOR J=0 TO 2:S=48+C(J):GOSUB 1200:POKE &HFF41,146+J*32:Q=Q+1:PRINT Q;:NEXT J
90 PRINT:PRINT"+ NOISE DRUM":GOSUB 1300:FOR I=1 TO 300:NEXT I:GOSUB 1300
100 PRINT"CHORDS: ";:FOR P=1 TO 8:READ C(0),C(1),C(2),H$:PRINT H$;" ";:GOSUB 1300
110 FOR K=0 TO 3:FOR J=0 TO 2:S=B(K)+C(J):GOSUB 1100:NEXT J,K:FOR J=0 TO 2:S=48+C(J):GOSUB 1200:NEXT J:NEXT P
120 PRINT:PRINT"ENVELOPES"
130 FOR K=0 TO 3:E=1200+K*450:R=11:V=E AND 255:GOSUB 1000:R=12:V=INT(E/256):GOSUB 1000:R=13:V=14:GOSUB 1000:FOR J=0 TO 2:R=8+J:V=16:GOSUB 1000:NEXT J,K
140 FOR I=1 TO 1500:NEXT I
150 PRINT"+ THE DAC":FOR I=1 TO 2:SOUND 89,3:SOUND 125,3:SOUND 147,3:SOUND 176,6:NEXT I
160 PRINT"FADE"
170 FOR L=12 TO 0 STEP -3:FOR K=0 TO 3:FOR J=0 TO 2:R=8+J:V=L:GOSUB 1000:NEXT J,K:FOR J=0 TO 2:POKE &HFF41,159+J*32-L:NEXT J:NEXT L
180 POKE &HFF41,255:PRINT"DONE":END
1000 POKE &HFF60,R:POKE &HFF62,3*M(K):POKE &HFF62,0:POKE &HFF60,V:POKE &HFF62,2*M(K):POKE &HFF62,0:RETURN
1100 R=2*J:V=T(S) AND 255:GOSUB 1000:R=R+1:V=INT(T(S)/256):GOSUB 1000:RETURN
1200 X=N(S):POKE &HFF41,128+J*32+(X AND 15):POKE &HFF41,INT(X/16):RETURN
1300 POKE &HFF41,228:FOR A=0 TO 15 STEP 3:POKE &HFF41,240+A:NEXT A:POKE &HFF41,255:RETURN
2000 DATA 0,4,7,C,9,12,16,AM,5,9,12,F,7,11,14,G
2010 DATA 0,4,7,C,9,12,16,AM,7,11,14,G,0,4,7,C
