' PIZERO-214: CoCo 3 feature checks, typed in by scripts/serial_type.py.
' Press Print Screen on each screen, then any other key to go on.
NEW
5 CLEAR 200,&H7EFF
10 WIDTH 40:CLS:PRINT "PIZERO-214 CHECKS":PRINT "PRINT SCREEN, THEN A KEY, ON EACH.":PRINT
20 ATTR 3,0:PRINT "1. WHITE ON GREEN":ATTR 1,2:PRINT "2. GREEN ON BLUE":ATTR 0,0,U:PRINT "3. UNDERLINED":ATTR 0,0,B:PRINT "4. BLINKING":ATTR 0,0:PRINT:PRINT "WIDTH 40 TEXT":GOSUB 900
30 PALETTE 0,36:PRINT "PALETTE 0,36: BACKGROUND RED":GOSUB 900:PALETTE 0,18
40 HSCREEN 1:HCLS 0:HCOLOR 1:HCIRCLE(160,96),60:HLINE(0,0)-(319,191),PSET,B:FOR C=0 TO 3:HCOLOR C:HLINE(C*40,170)-(C*40+38,190),PSET,BF:NEXT:HPRINT(2,1),"HSCREEN 1: 4 BARS":GOSUB 900
50 HSCREEN 2:HCLS 1:HCOLOR 4:HCIRCLE(160,96),60:HLINE(0,0)-(319,191),PSET,B:HCOLOR 2:HPAINT(160,96),2,4
55 FOR C=0 TO 15:HCOLOR C:HLINE(C*20,170)-(C*20+18,190),PSET,BF:NEXT:HPRINT(2,1),"HSCREEN 2: 16 BARS":GOSUB 900
60 HSCREEN 0:WIDTH 32:CLS:POKE &HFFBD,36:POKE &HFFBC,63:PRINT "POKE &HFFBC,&HFFBD:":PRINT "WHITE ON RED":GOSUB 900:POKE &HFFBC,0:POKE &HFFBD,18:CLS
70 FOR I=0 TO 29:READ A:POKE &H7F00+I,A:NEXT:FOR I=0 TO 20:READ A:POKE &H7F30+I,A:NEXT
75 PRINT "GIME TIMER, RELOAD 10, IRQS":PRINT "PER FIELD OVER 300 FIELDS:":GOSUB 800:PRINT "AT 0.89 MHZ:";INT(N/V*10+.5)/10:POKE 65497,0:GOSUB 800:POKE 65496,0:PRINT "AT 1.79 MHZ:";INT(N/V*10+.5)/10:PRINT "EXPECT 23.9 (1987 GIME)":GOSUB 900
80 PRINT "DONE":END
800 FOR I=0 TO 3:POKE &H7F20+I,0:NEXT:POKE &HFF91,0:POKE &HFF95,10:POKE &HFF94,0:POKE &HFF92,40:EXEC &H7F30
810 IF PEEK(&H7F22)*256+PEEK(&H7F23)<300 THEN 810
820 POKE &HFF92,0:N=PEEK(&H7F20)*256+PEEK(&H7F21):V=PEEK(&H7F22)*256+PEEK(&H7F23):RETURN
900 IF INKEY$="" THEN 900 ELSE RETURN
980 DATA 182,255,146,133,32,39,8,190,127,32,48,1,191,127,32,133,8,39,8,190,127,34,48,1,191,127,34,126,1,12
990 DATA 26,80,134,126,183,254,247,204,127,0,253,254,248,134,236,183,255,144,28,175,57
RUN
